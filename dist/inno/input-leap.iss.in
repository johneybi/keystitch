#define MyAppName "Input Leap Keymap"
#define MyAppVersion "@INPUTLEAP_VERSION_MAJOR@.@INPUTLEAP_VERSION_MINOR@.@INPUTLEAP_VERSION_PATCH@.0"
#define MyAppTextVersion "@INPUTLEAP_VERSION@"
#define MyAppPublisher "Input Leap Keymap contributors"
#define MyAppURL "https://github.com/johneybi/keystitch"
#define MyAppCopyright "Copyright (C) Input Leap Keymap contributors"
#define MyAppExeName "input-leap.exe"
#define MyAppListenerDesc "Input Leap Keymap Listener"

; CMake installs the current MSVC runtime beside the application. Do not
; fall back to downloading an obsolete runtime during end-user setup.
#if !FileExists("@CMAKE_INSTALL_PREFIX@/msvcp140.dll") || !FileExists("@CMAKE_INSTALL_PREFIX@/vcruntime140.dll") || !FileExists("@CMAKE_INSTALL_PREFIX@/vcruntime140_1.dll")
  #error Required app-local MSVC runtime is missing; run cmake --install first.
#endif
#if !FileExists("@CMAKE_INSTALL_PREFIX@/platforms/qwindows.dll")
  #error Qt Windows platform plugin is missing from the staging directory.
#endif

[Setup]
AppId={{D9785C41-CF76-4DC8-9460-FCA5EF15558A}
AppName={#MyAppName}
AppVersion={#MyAppTextVersion}
AppVerName={#MyAppName} {#MyAppTextVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={pf}\{#MyAppName}
DisableProgramGroupPage=yes
LicenseFile=@CMAKE_CURRENT_SOURCE_DIR@/res/License.rtf
OutputDir=@CMAKE_INSTALL_PREFIX@/../installer-inno/bin
OutputBaseFilename=InputLeapKeymapSetup-{#MyAppTextVersion}
SetupIconFile=@CMAKE_CURRENT_SOURCE_DIR@/res/input-leap.ico
VersionInfoProductTextVersion={#MyAppTextVersion}
VersionInfoProductVersion={#MyAppVersion}
VersionInfoTextVersion={#MyAppTextVersion}
VersionInfoVersion={#MyAppVersion}
VersionInfoCopyright={#MyAppCopyright}

Compression=lzma
SolidCompression=yes
ArchitecturesInstallIn64BitMode=x64
UninstallDisplayIcon={app}\{#MyAppExeName}

#include "scripts\lang\english.iss"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "@CMAKE_INSTALL_PREFIX@/*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Registry]
; Prevent an obsolete Barrier wrapper from starting a second server beside this GUI.
Root: HKCU; Subkey: "Software\Microsoft\Windows\CurrentVersion\Run"; ValueType: none; ValueName: "Barrier Keymap"
; The migration writes the value only after validating the public install.
Root: HKLM64; Subkey: "Software\Microsoft\Windows\CurrentVersion\Run"; ValueType: none; ValueName: "KeyStitch"; Flags: uninsdeletevalue

[Icons]
Name: "{commonprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{commondesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
; there's no "check if exists" or "insert if not exists" for netsh's firewall commands
; to avoid duplicate entries remove the existing rule (fails if it doesn't exist) before adding
Filename: {sys}\netsh.exe; Parameters: "advfirewall firewall delete rule name=""{#MyAppListenerDesc}"""; Flags: runhidden
Filename: {sys}\netsh.exe; Parameters: "advfirewall firewall add rule name=""{#MyAppListenerDesc}"" protocol=TCP dir=in localport=24800 action=allow"; Flags: runhidden
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent

[UninstallRun]
Filename: {sys}\netsh.exe; Parameters: "advfirewall firewall delete rule name=""{#MyAppListenerDesc}"""; Flags: runhidden; RunOnceId: "RemoveInputLeapKeymapListener"

[Code]
#include "scripts\migrate-startup.iss"
